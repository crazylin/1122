<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Avalonia3DControls.MainWindow"
        Title="Avalonia 3D 控件演示"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
            <TextBlock Text="3D 控件演示" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Separator/>
            <Button Content="添加3D按钮" Click="OnAdd3DButton"/>
            <Button Content="添加3D滑块" Click="OnAdd3DSlider"/>
            <Button Content="添加3D开关" Click="OnAdd3DSwitch"/>
            <Button Content="添加3D进度条" Click="OnAdd3DProgressBar"/>
            <Button Content="添加3D文本框" Click="OnAdd3DTextBox"/>
            <Button Content="清除所有" Click="OnClearAll"/>
        </StackPanel>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 3D场景区域 -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="10">
                <Canvas x:Name="Canvas3D" Background="Black">
                    <!-- 3D控件将在这里动态添加 -->
                </Canvas>
            </Border>

            <!-- 右侧控制面板 -->
            <ScrollViewer Grid.Column="1" Margin="10">
                <StackPanel Spacing="15">
                    <TextBlock Text="控件属性" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    
                    <Separator/>
                    
                    <TextBlock Text="场景信息" FontWeight="SemiBold"/>
                    <TextBlock x:Name="InfoText" Text="准备就绪" TextWrapping="Wrap"/>
                    
                    <Separator/>
                    
                    <TextBlock Text="3D控件说明" FontWeight="SemiBold"/>
                    <TextBlock Text="• 3D按钮：可点击的立体按钮控件" TextWrapping="Wrap"/>
                    <TextBlock Text="• 3D滑块：可拖拽的立体滑块控件" TextWrapping="Wrap"/>
                    <TextBlock Text="• 3D开关：可切换的立体开关控件" TextWrapping="Wrap"/>
                    <TextBlock Text="• 3D进度条：立体进度显示控件" TextWrapping="Wrap"/>
                    <TextBlock Text="• 3D文本框：立体文本输入控件" TextWrapping="Wrap"/>
                    
                    <Separator/>
                    
                    <TextBlock Text="操作说明" FontWeight="SemiBold"/>
                    <TextBlock Text="• 鼠标左键：点击3D控件" TextWrapping="Wrap"/>
                    <TextBlock Text="• 鼠标拖拽：移动3D控件" TextWrapping="Wrap"/>
                    <TextBlock Text="• 滚轮缩放：调整控件大小" TextWrapping="Wrap"/>
                    
                    <Separator/>
                    
                    <TextBlock Text="自定义设置" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="控件大小:" VerticalAlignment="Center"/>
                        <Slider x:Name="SizeSlider" Minimum="0.5" Maximum="2.0" Value="1.0" Width="100"/>
                        <TextBlock x:Name="SizeValue" Text="1.0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="控件间距:" VerticalAlignment="Center"/>
                        <Slider x:Name="SpacingSlider" Minimum="1.0" Maximum="5.0" Value="3.0" Width="100"/>
                        <TextBlock x:Name="SpacingValue" Text="3.0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>